node_modules/
dist/
.astro/

# Churns on every pane move; the rest of .obsidian/ is committed so a fresh
# clone is a working vault.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# The vault root is the REPO root. Opening a subfolder as its own vault makes
# Obsidian write a second config there with useMarkdownLinks defaulting to
# false — which emits ![[wikilinks]] that Astro cannot resolve. Keep any such
# stray config out of the repo.
src/**/.obsidian/

.env
.env.*
.DS_Store

# Claude Code per-machine local permissions; not for a public repo
.claude/settings.local.json
