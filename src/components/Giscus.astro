---
// Comments via GitHub Discussions on this repo.
//
// data-repo-id and data-category-id come from giscus.app after the giscus app
// is installed and Discussions are enabled — see quickstart.md §B. They are
// public identifiers, not secrets, which is why they live in the component.
//
// Fetched from the GitHub GraphQL API, not copied out of giscus.app:
//   repository(owner:..., name:...) { id, discussionCategories { nodes { id name } } }
// The component still renders a visible note if either is blank, because a
// wrong or missing id fails as an empty box that is easy to miss.
// Typed as `string`, not inferred as literals, so the guard below stays a real
// runtime check rather than a comparison TypeScript can prove always true.
const REPO: string = 'john-pachec0/circulus-circulorum';
const REPO_ID: string = 'R_kgDOUMYKCg';
const CATEGORY_ID: string = 'DIC_kwDOUMYKCs4DEv4-';

const configured = REPO_ID !== '' && CATEGORY_ID !== '';
---

<section class="comments">
  {
    configured ? (
      // is:inline is REQUIRED. Without it Astro processes and bundles the tag,
      // which drops the data-* attributes giscus reads off its own <script>
      // element, and the widget silently never loads.
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={REPO}
        data-repo-id={REPO_ID}
        data-category="Comments"
        data-category-id={CATEGORY_ID}
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async
      />
    ) : (
      <p class="meta">
        Comments are not wired up yet — set <code>REPO_ID</code> and{' '}
        <code>CATEGORY_ID</code> in <code>src/components/Giscus.astro</code> from{' '}
        <a href="https://giscus.app/">giscus.app</a>.
      </p>
    )
  }
</section>
