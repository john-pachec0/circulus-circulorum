---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts } from '../posts';

const posts = await publishedPosts();
---

<BaseLayout>
  {
    posts.length === 0 ? (
      <p class="meta">Nothing published yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </ul>
    )
  }
</BaseLayout>
